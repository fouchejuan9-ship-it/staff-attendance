{
  "name": "mikas-mind-quest",
  "version": "0.1.0",
  "private": true,
  "description": "Mika's Mind Quest: a Grade 2 learning game. Numbers, puzzles, words, emoji stories and solids, liquids and gases.",
  "scripts": {
    "start": "npx --yes serve www -l 3000",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "ios:add": "cap add ios",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios",
    "icons": "npx --yes @capacitor/assets generate --iconBackgroundColor '#f7ead0' --splashBackgroundColor '#f7ead0'"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  }
}
